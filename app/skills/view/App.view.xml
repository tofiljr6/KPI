<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    controllerName="kip.skillauthoring.controller.App"
    displayBlock="true">

    <f:DynamicPage id="page" fitContent="false" toggleHeaderOnTitleClick="false">

        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>pageTitle}" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <VBox class="sapUiSmallMarginBottom" width="100%">
                    <Label text="{i18n>promptLabel}" labelFor="prompt" />
                    <TextArea
                        id="prompt"
                        width="100%"
                        rows="2"
                        growing="true"
                        value="{/query}"
                        placeholder="{i18n>promptPlaceholder}"
                        class="sapUiTinyMarginBottom" />
                    <HBox justifyContent="End" width="100%">
                        <Button
                            text="{= ${/busy} ? ${i18n>generating} : (${/generated} ? ${i18n>regenerate} : ${i18n>generate}) }"
                            type="Emphasized"
                            icon="sap-icon://ai"
                            enabled="{= !${/busy} &amp;&amp; ${/query}.length > 0 }"
                            press=".onGenerate" />
                    </HBox>
                </VBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <VBox>
                <MessageStrip
                    id="hint"
                    visible="{/generated}"
                    type="Information"
                    showIcon="true"
                    text="{i18n>genOk}"
                    class="sapUiSmallMarginBottom" />

                <form:SimpleForm
                    id="draftForm"
                    visible="{/generated}"
                    editable="true"
                    layout="ColumnLayout"
                    columnsM="1"
                    columnsL="1"
                    columnsXL="1"
                    title="{i18n>draftGroup}">
                    <Label text="{i18n>fName}" />
                    <Input value="{/skill/SkillName}" />

                    <Label text="{i18n>fDescription}" />
                    <TextArea value="{/skill/SkillDescription}" rows="2" growing="true" width="100%" />

                    <Label text="{i18n>fTrigger}" />
                    <TextArea value="{/skill/SkillTriggerText}" rows="2" growing="true" width="100%" />

                    <Label text="{i18n>fTable}" />
                    <Input value="{/skill/QueryTable}" />

                    <Label text="{i18n>fFields}" />
                    <TextArea value="{/skill/QueryFields}" rows="2" growing="true" width="100%" />

                    <Label text="{i18n>fWhere}" />
                    <Input value="{/skill/QueryWhere}" />
                </form:SimpleForm>

                <Panel
                    visible="{/generated}"
                    headerText="{i18n>analysisGroup}"
                    expandable="true"
                    expanded="false"
                    class="sapUiSmallMarginTop">
                    <form:SimpleForm editable="false" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
                        <Label text="Reasoning" />
                        <Text text="{/meta/reasoning}" />
                        <Label text="Chosen table" />
                        <Text text="{/meta/table}" />
                        <Label text="Key field" />
                        <Text text="{/meta/keyField}" />
                        <Label text="Confidence" />
                        <ObjectStatus
                            text="{/meta/confidence}"
                            state="{= ${/meta/confidence} === 'high' ? 'Success' : (${/meta/confidence} === 'medium' ? 'Warning' : 'Error') }" />
                        <Label text="Alternatives" />
                        <Text text="{/meta/alternatives}" />
                        <Label text="Candidate fields" />
                        <Text text="{/meta/candidateFields}" />
                    </form:SimpleForm>
                </Panel>
            </VBox>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="{i18n>reset}" press=".onReset" enabled="{/generated}" />
                <Button
                    text="{i18n>save}"
                    type="Emphasized"
                    icon="sap-icon://save"
                    press=".onSave"
                    enabled="{= ${/generated} &amp;&amp; !${/busy} }" />
            </OverflowToolbar>
        </f:footer>

    </f:DynamicPage>
</mvc:View>
