<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    controllerName="kip.skillauthoring.controller.App"
    displayBlock="true">

    <App id="app">

        <!-- ============ LIST REPORT ============ -->
        <Page id="listPage" backgroundDesign="List">

            <customHeader>
                <f:ShellBar
                    title="{i18n>shellTitle}"
                    secondTitle="{i18n>shellSubtitle}"
                    showNotifications="false"
                    showProductSwitcher="false"
                    showCopilot="false"
                    showSearch="false">
                    <f:profile>
                        <Avatar initials="KIP" displaySize="XS" backgroundColor="Accent6" />
                    </f:profile>
                </f:ShellBar>
            </customHeader>

            <content>
                <Table
                    id="skillsTable"
                    items="{/skills}"
                    busy="{/busy}"
                    busyIndicatorDelay="0"
                    growing="true"
                    growingThreshold="50"
                    growingScrollToLoad="true"
                    mode="None"
                    sticky="ColumnHeaders,HeaderToolbar"
                    autoPopinMode="true"
                    popinLayout="GridSmall"
                    alternateRowColors="true"
                    class="sapUiResponsiveMargin"
                    width="auto">

                    <headerToolbar>
                        <OverflowToolbar>
                            <Title id="listTitle" text="{i18n>listTitle}" level="H2" />
                            <ObjectStatus
                                text="{= (${/skills} || []).length }"
                                state="Information"
                                inverted="true"
                                class="sapUiTinyMarginBegin" />
                            <ToolbarSpacer />
                            <SearchField
                                width="18rem"
                                placeholder="{i18n>search}"
                                search=".onSearch"
                                liveChange=".onSearch" />
                            <Button
                                icon="sap-icon://refresh"
                                type="Transparent"
                                tooltip="{i18n>refresh}"
                                press=".onRefresh" />
                            <ToolbarSeparator />
                            <Button
                                text="{i18n>createNew}"
                                type="Emphasized"
                                icon="sap-icon://add"
                                press=".onOpenCreate" />
                        </OverflowToolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="20rem" importance="High">
                            <Text text="{i18n>colName}" />
                        </Column>
                        <Column width="10rem" hAlign="Begin" importance="High">
                            <Text text="{i18n>colTable}" />
                        </Column>
                        <Column importance="Medium">
                            <Text text="{i18n>colFields}" />
                        </Column>
                        <Column importance="Low">
                            <Text text="{i18n>colWhere}" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onOpenDetails">
                            <cells>
                                <ObjectIdentifier title="{SkillName}" text="{SkillDescription}" />
                                <ObjectStatus text="{QueryTable}" state="Information" />
                                <Text text="{QueryFields}" class="kipMono" emptyIndicatorMode="On" />
                                <Text text="{QueryWhere}" class="kipMono" emptyIndicatorMode="On" />
                            </cells>
                        </ColumnListItem>
                    </items>

                    <noData>
                        <IllustratedMessage
                            illustrationType="sapIllus-NoEntries"
                            title="{i18n>noSkillsTitle}"
                            description="{i18n>noSkillsText}">
                            <additionalContent>
                                <Button
                                    text="{i18n>createNew}"
                                    type="Emphasized"
                                    icon="sap-icon://add"
                                    press=".onOpenCreate" />
                            </additionalContent>
                        </IllustratedMessage>
                    </noData>
                </Table>
            </content>
        </Page>

        <!-- ============ OBJECT PAGE – CREATE ============ -->
        <Page id="createPage" backgroundDesign="Standard">

            <customHeader>
                <f:ShellBar
                    title="{i18n>shellTitle}"
                    secondTitle="{i18n>newSkillTitle}"
                    showNavButton="true"
                    navButtonPressed=".onCloseCreate"
                    showNotifications="false"
                    showProductSwitcher="false"
                    showCopilot="false"
                    showSearch="false" />
            </customHeader>

            <content>
                <uxap:ObjectPageLayout
                    id="createOP"
                    class="kipCreatePage"
                    showTitleInHeaderContent="true"
                    upperCaseAnchorBar="false"
                    useIconTabBar="false"
                    busy="{create>/busy}"
                    busyIndicatorDelay="0">

                    <uxap:headerTitle>
                        <uxap:ObjectPageDynamicHeaderTitle>
                            <uxap:heading>
                                <Title text="{= ${create>/skill/SkillName} || ${i18n>newSkillTitle} }" />
                            </uxap:heading>
                            <uxap:snappedContent>
                                <Text text="{= ${create>/query} || ${i18n>promptLabel} }" maxLines="1" />
                            </uxap:snappedContent>
                            <uxap:expandedContent>
                                <Text text="{i18n>newSkillHint}" />
                            </uxap:expandedContent>
                        </uxap:ObjectPageDynamicHeaderTitle>
                    </uxap:headerTitle>

                    <uxap:headerContent>
                        <VBox width="100%" class="kipPromptBox">
                            <Label text="{i18n>promptLabel}" labelFor="prompt" design="Bold" />
                            <TextArea
                                id="prompt"
                                width="100%"
                                rows="3"
                                growing="true"
                                growingMaxLines="8"
                                valueLiveUpdate="true"
                                value="{create>/query}"
                                placeholder="{i18n>promptPlaceholder}"
                                class="sapUiTinyMarginTop sapUiTinyMarginBottom" />
                            <HBox justifyContent="End" alignItems="Center" width="100%">
                                <Text
                                    visible="{create>/generated}"
                                    text="{i18n>generatedHint}"
                                    class="sapUiTinyMarginEnd" />
                                <Button
                                    text="{= ${create>/busy} ? ${i18n>generating} : (${create>/generated} ? ${i18n>regenerate} : ${i18n>generate}) }"
                                    type="Emphasized"
                                    icon="sap-icon://ai"
                                    enabled="{= !${create>/busy} &amp;&amp; ${create>/query}.length > 0 }"
                                    press=".onGenerate" />
                            </HBox>
                        </VBox>
                    </uxap:headerContent>

                    <uxap:sections>
                        <uxap:ObjectPageSection titleUppercase="false" title="{i18n>draftGroup}">
                            <uxap:subSections>
                                <uxap:ObjectPageSubSection>
                                    <VBox width="100%">
                                        <MessageStrip
                                            visible="{create>/generated}"
                                            type="Success"
                                            showIcon="true"
                                            text="{i18n>genOk}"
                                            class="sapUiSmallMarginBottom" />
                                        <form:SimpleForm
                                            width="100%"
                                            maxContainerCols="1"
                                            editable="true"
                                            layout="ResponsiveGridLayout"
                                            labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
                                            adjustLabelSpan="false"
                                            emptySpanXL="1" emptySpanL="1" emptySpanM="0"
                                            columnsXL="1" columnsL="1" columnsM="1"
                                            singleContainerFullSize="true">
                                            <Label text="{i18n>fName}" required="true" />
                                            <Input value="{create>/skill/SkillName}" placeholder="{i18n>fNamePh}" />
                                            <Label text="{i18n>fDescription}" />
                                            <TextArea value="{create>/skill/SkillDescription}" rows="2" growing="true" width="100%" />
                                            <Label text="{i18n>fTrigger}" />
                                            <TextArea value="{create>/skill/SkillTriggerText}" rows="2" growing="true" width="100%" />
                                            <Label text="{i18n>fTable}" required="true" />
                                            <Input value="{create>/skill/QueryTable}" class="kipMono" placeholder="e.g. BUT000" />
                                            <Label text="{i18n>fFields}" />
                                            <TextArea value="{create>/skill/QueryFields}" rows="2" growing="true" width="100%" class="kipMono" />
                                            <Label text="{i18n>fWhere}" />
                                            <Input value="{create>/skill/QueryWhere}" class="kipMono" />
                                        </form:SimpleForm>
                                    </VBox>
                                </uxap:ObjectPageSubSection>
                            </uxap:subSections>
                        </uxap:ObjectPageSection>

                        <uxap:ObjectPageSection titleUppercase="false" title="{i18n>analysisGroup}" visible="{create>/generated}">
                            <uxap:subSections>
                                <uxap:ObjectPageSubSection>
                                    <form:SimpleForm
                                        width="100%"
                                        maxContainerCols="1"
                                        editable="false"
                                        layout="ResponsiveGridLayout"
                                        labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
                                        adjustLabelSpan="false"
                                        emptySpanXL="1" emptySpanL="1" emptySpanM="0"
                                        columnsXL="1" columnsL="1" columnsM="1"
                                        singleContainerFullSize="true">
                                        <Label text="{i18n>aConfidence}" />
                                        <ObjectStatus
                                            text="{= ${create>/meta/confidence} || '–' }"
                                            icon="{= ${create>/meta/confidence} === 'high' ? 'sap-icon://message-success' : (${create>/meta/confidence} === 'medium' ? 'sap-icon://message-warning' : 'sap-icon://message-error') }"
                                            state="{= ${create>/meta/confidence} === 'high' ? 'Success' : (${create>/meta/confidence} === 'medium' ? 'Warning' : 'Error') }" />
                                        <Label text="{i18n>aTable}" />
                                        <ObjectStatus text="{= ${create>/meta/table} || '–' }" state="Information" />
                                        <Label text="{i18n>aKey}" />
                                        <Text text="{= ${create>/meta/keyField} || '–' }" class="kipMono" />
                                        <Label text="{i18n>aReasoning}" />
                                        <Text text="{= ${create>/meta/reasoning} || '–' }" />
                                        <Label text="{i18n>aAlternatives}" />
                                        <Text text="{= ${create>/meta/alternatives} || '–' }" class="kipMono" />
                                        <Label text="{i18n>aCandidates}" />
                                        <Text text="{= ${create>/meta/candidateFields} || '–' }" class="kipMono" />
                                    </form:SimpleForm>
                                </uxap:ObjectPageSubSection>
                            </uxap:subSections>
                        </uxap:ObjectPageSection>
                    </uxap:sections>

                    <uxap:footer>
                        <OverflowToolbar>
                            <ToolbarSpacer />
                            <Button text="{i18n>cancel}" press=".onCloseCreate" />
                            <Button
                                text="{i18n>save}"
                                type="Emphasized"
                                icon="sap-icon://save"
                                enabled="{= ${create>/generated} &amp;&amp; !${create>/busy} }"
                                press=".onSaveNew" />
                        </OverflowToolbar>
                    </uxap:footer>
                </uxap:ObjectPageLayout>
            </content>
        </Page>

    </App>
</mvc:View>
