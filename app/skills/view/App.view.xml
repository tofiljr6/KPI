<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    controllerName="kip.skillauthoring.controller.App"
    displayBlock="true">

    <App id="app">

        <!-- ============ LIST REPORT ============ -->
        <Page id="listPage" backgroundDesign="List">
            <customHeader>
                <f:ShellBar
                    title="{i18n>shellTitle}"
                    secondTitle="{i18n>shellSubtitle}"
                    showNotifications="false"
                    showProductSwitcher="false"
                    showCopilot="false"
                    showSearch="false">
                    <f:profile>
                        <Avatar initials="KIP" displaySize="XS" backgroundColor="Accent6" />
                    </f:profile>
                </f:ShellBar>
            </customHeader>

            <subHeader>
                <OverflowToolbar>
                    <Title text="{i18n>listTitle}" level="H2" />
                    <ObjectStatus text="{= (${/skills} || []).length }" state="Information" class="sapUiTinyMarginBegin" />
                    <ToolbarSpacer />
                    <SearchField width="18rem" placeholder="{i18n>search}" search=".onSearch" liveChange=".onSearch" />
                    <Button icon="sap-icon://refresh" tooltip="{i18n>refresh}" press=".onRefresh" />
                    <Button text="{i18n>createNew}" type="Emphasized" icon="sap-icon://add" press=".onOpenCreate" />
                </OverflowToolbar>
            </subHeader>

            <content>
                <Table
                    id="skillsTable"
                    items="{/skills}"
                    growing="true"
                    growingThreshold="50"
                    busy="{/busy}"
                    mode="None"
                    sticky="ColumnHeaders,HeaderToolbar"
                    class="sapUiResponsiveMargin"
                    width="auto">

                    <columns>
                        <Column width="18rem"><Text text="{i18n>colName}" /></Column>
                        <Column width="9rem"><Text text="{i18n>colTable}" /></Column>
                        <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>colFields}" /></Column>
                        <Column minScreenWidth="Desktop" demandPopin="true"><Text text="{i18n>colWhere}" /></Column>
                    </columns>

                    <items>
                        <ColumnListItem type="Navigation" press=".onOpenDetails">
                            <cells>
                                <ObjectIdentifier title="{SkillName}" text="{SkillDescription}" />
                                <Text text="{QueryTable}" />
                                <Text text="{QueryFields}" />
                                <Text text="{QueryWhere}" />
                            </cells>
                        </ColumnListItem>
                    </items>

                    <noData>
                        <IllustratedMessage
                            illustrationType="sapIllus-NoEntries"
                            title="{i18n>noSkillsTitle}"
                            description="{i18n>noSkillsText}" />
                    </noData>
                </Table>
            </content>
        </Page>

        <!-- ============ OBJECT PAGE – CREATE ============ -->
        <Page id="createPage" backgroundDesign="Standard">
            <customHeader>
                <f:ShellBar
                    title="{i18n>shellTitle}"
                    secondTitle="{i18n>newSkillTitle}"
                    showNavButton="true"
                    navButtonPressed=".onCloseCreate"
                    showNotifications="false"
                    showProductSwitcher="false"
                    showCopilot="false"
                    showSearch="false" />
            </customHeader>

            <content>
                <uxap:ObjectPageLayout id="createOP" showTitleInHeaderContent="true" upperCaseAnchorBar="false" busy="{create>/busy}">

                    <uxap:headerTitle>
                        <uxap:ObjectPageDynamicHeaderTitle>
                            <uxap:heading>
                                <Title text="{= ${create>/skill/SkillName} || ${i18n>newSkillTitle} }" />
                            </uxap:heading>
                            <uxap:snappedContent>
                                <Text text="{create>/query}" />
                            </uxap:snappedContent>
                            <uxap:actions>
                                <Button text="{i18n>cancel}" press=".onCloseCreate" />
                                <Button
                                    text="{i18n>save}"
                                    type="Emphasized"
                                    icon="sap-icon://save"
                                    enabled="{= ${create>/generated} &amp;&amp; !${create>/busy} }"
                                    press=".onSaveNew" />
                            </uxap:actions>
                        </uxap:ObjectPageDynamicHeaderTitle>
                    </uxap:headerTitle>

                    <uxap:headerContent>
                        <VBox width="100%" class="sapUiSmallMarginBottom">
                            <Label text="{i18n>promptLabel}" labelFor="prompt" />
                            <TextArea
                                id="prompt"
                                width="100%"
                                rows="2"
                                growing="true"
                                value="{create>/query}"
                                placeholder="{i18n>promptPlaceholder}"
                                class="sapUiTinyMarginBottom" />
                            <HBox justifyContent="End" width="100%">
                                <Button
                                    text="{= ${create>/busy} ? ${i18n>generating} : (${create>/generated} ? ${i18n>regenerate} : ${i18n>generate}) }"
                                    type="Emphasized"
                                    icon="sap-icon://ai"
                                    enabled="{= !${create>/busy} &amp;&amp; ${create>/query}.length > 0 }"
                                    press=".onGenerate" />
                            </HBox>
                        </VBox>
                    </uxap:headerContent>

                    <uxap:sections>
                        <uxap:ObjectPageSection title="{i18n>draftGroup}">
                            <uxap:subSections>
                                <uxap:ObjectPageSubSection>
                                    <VBox width="100%">
                                        <HBox justifyContent="Center" width="100%">
                                            <MessageStrip
                                                visible="{create>/generated}"
                                                type="Information"
                                                showIcon="true"
                                                text="{i18n>genOk}"
                                                class="sapUiSmallMarginBottom sapUiTinyMarginTop" />
                                        </HBox>
                                        <form:SimpleForm
                                            width="100%"
                                            maxContainerCols="1"
                                            editable="true"
                                            layout="ResponsiveGridLayout"
                                            labelSpanXL="3" labelSpanL="3" labelSpanM="3" labelSpanS="12"
                                            adjustLabelSpan="false"
                                            emptySpanXL="1" emptySpanL="1" emptySpanM="0"
                                            columnsXL="1" columnsL="1" columnsM="1"
                                            singleContainerFullSize="true">
                                            <Label text="{i18n>fName}" />
                                            <Input value="{create>/skill/SkillName}" />
                                            <Label text="{i18n>fDescription}" />
                                            <TextArea value="{create>/skill/SkillDescription}" rows="2" growing="true" width="100%" />
                                            <Label text="{i18n>fTrigger}" />
                                            <TextArea value="{create>/skill/SkillTriggerText}" rows="2" growing="true" width="100%" />
                                            <Label text="{i18n>fTable}" />
                                            <Input value="{create>/skill/QueryTable}" />
                                            <Label text="{i18n>fFields}" />
                                            <TextArea value="{create>/skill/QueryFields}" rows="2" growing="true" width="100%" />
                                            <Label text="{i18n>fWhere}" />
                                            <Input value="{create>/skill/QueryWhere}" />
                                        </form:SimpleForm>
                                    </VBox>
                                </uxap:ObjectPageSubSection>
                            </uxap:subSections>
                        </uxap:ObjectPageSection>

                        <uxap:ObjectPageSection title="{i18n>analysisGroup}" visible="{create>/generated}">
                            <uxap:subSections>
                                <uxap:ObjectPageSubSection>
                                    <form:SimpleForm
                                        width="100%"
                                        maxContainerCols="1"
                                        editable="false"
                                        layout="ResponsiveGridLayout"
                                        labelSpanXL="2" labelSpanL="2" labelSpanM="3" labelSpanS="12"
                                        adjustLabelSpan="false"
                                        emptySpanXL="0" emptySpanL="0" emptySpanM="0"
                                        columnsXL="1" columnsL="1" columnsM="1"
                                        singleContainerFullSize="true">
                                        <Label text="{i18n>aReasoning}" />
                                        <Text text="{create>/meta/reasoning}" />
                                        <Label text="{i18n>aTable}" />
                                        <Text text="{create>/meta/table}" />
                                        <Label text="{i18n>aKey}" />
                                        <Text text="{create>/meta/keyField}" />
                                        <Label text="{i18n>aConfidence}" />
                                        <ObjectStatus
                                            text="{create>/meta/confidence}"
                                            state="{= ${create>/meta/confidence} === 'high' ? 'Success' : (${create>/meta/confidence} === 'medium' ? 'Warning' : 'Error') }" />
                                        <Label text="{i18n>aAlternatives}" />
                                        <Text text="{create>/meta/alternatives}" />
                                        <Label text="{i18n>aCandidates}" />
                                        <Text text="{create>/meta/candidateFields}" />
                                    </form:SimpleForm>
                                </uxap:ObjectPageSubSection>
                            </uxap:subSections>
                        </uxap:ObjectPageSection>
                    </uxap:sections>

                    <uxap:footer>
                        <OverflowToolbar>
                            <ToolbarSpacer />
                            <Button text="{i18n>cancel}" press=".onCloseCreate" />
                            <Button
                                text="{i18n>save}"
                                type="Emphasized"
                                icon="sap-icon://save"
                                enabled="{= ${create>/generated} &amp;&amp; !${create>/busy} }"
                                press=".onSaveNew" />
                        </OverflowToolbar>
                    </uxap:footer>
                </uxap:ObjectPageLayout>
            </content>
        </Page>

    </App>
</mvc:View>
