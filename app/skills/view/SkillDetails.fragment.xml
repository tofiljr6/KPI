<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        title="{detail>/SkillName}"
        contentWidth="42rem"
        draggable="true"
        resizable="true">
        <content>
            <form:SimpleForm editable="false" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1">
                <Label text="{i18n>fDescription}" />
                <Text text="{detail>/SkillDescription}" emptyIndicatorMode="On" />
                <Label text="{i18n>fTrigger}" />
                <Text text="{detail>/SkillTriggerText}" emptyIndicatorMode="On" />
                <Label text="{i18n>fTable}" />
                <ObjectStatus text="{detail>/QueryTable}" state="Information" />
                <Label text="{i18n>fFields}" />
                <Text text="{detail>/QueryFields}" class="kipMono" emptyIndicatorMode="On" />
                <Label text="{i18n>fWhere}" />
                <Text text="{detail>/QueryWhere}" class="kipMono" emptyIndicatorMode="On" />
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="{i18n>close}" type="Emphasized" press=".onCloseDetails" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
