# Local run in SAP Business Application Studio (BAS).
#
# Copy this file to `.env` and fill in the values, OR let BAS generate it:
#   right-click the project -> "Bind to Cloud Foundry Services" (connectivity + destination),
#   which writes VCAP_SERVICES + the `destinations` line with the local proxy (127.0.0.1:8887).
#
# `.env` is git-ignored. Do NOT commit real credentials.
#
# Then run:  npx cds watch   (NOT `--profile hybrid`, do NOT `cds bind`)

# Service keys for the CF `connectivity` and `destination` instances in your dev space.
# Get them from BAS binding, or: cf service-key <instance> <key> | ...
VCAP_SERVICES={"connectivity":[{"label":"connectivity","tags":["connectivity"],"credentials":{"clientid":"<clientid>","clientsecret":"<clientsecret>","onpremise_proxy_host":"connectivityproxy.internal.cf.<region>.hana.ondemand.com","onpremise_proxy_port":"20003","tenantid":"<subaccount-id>","token_service_url":"https://<subdomain>.authentication.<region>.hana.ondemand.com","uaadomain":"authentication.<region>.hana.ondemand.com","xsappname":"<xsappname>"}}],"destination":[{"label":"destination","tags":["destination"],"credentials":{"clientid":"<clientid>","clientsecret":"<clientsecret>","tenantid":"<subaccount-id>","uri":"https://destination-configuration.cfapps.<region>.hana.ondemand.com","url":"https://<subdomain>.authentication.<region>.hana.ondemand.com","uaadomain":"authentication.<region>.hana.ondemand.com","xsappname":"<xsappname>"}}]}

# Points the SDK at the BAS local connectivity proxy, which tunnels to the
# Cloud Connector. `url` stays the literal "<name>.dest" placeholder.
destinations=[{"name":"SA1_300","url":"http://SA1_300.dest","proxyConfiguration":{"host":"127.0.0.1","port":8887,"protocol":"http"}}]

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# Everyday model: routing, answer formatting, revision prose.
OPENAI_MODEL=gpt-4o-mini

# Skill generation only — working out the SAP table and the real field names.
# Falls back to OPENAI_MODEL when unset. A stronger model here pays off.
# OPENAI_AUTHORING_MODEL=gpt-4.1
# Run the authoring model as a reasoning-model call: low | medium | high
# OPENAI_AUTHORING_REASONING_EFFORT=medium

# Web-search step that grounds skill generation in the real SAP data model
# (SAP Help Portal / SE11). Needs a model that supports the built-in web_search tool.
# OPENAI_RESEARCH_MODEL=gpt-4.1-mini
# Older openai SDKs call the tool "web_search_preview" (the default here); newer ones "web_search".
# OPENAI_WEB_SEARCH_TOOL=web_search_preview

# optional corporate proxy if the OpenAI call gets "Premature close":
# HTTPS_PROXY=http://proxy.firma.local:8080
